# Copy to .env for local work. Production values go in the Render dashboard.
DEBUG=1
# Required when DEBUG=0 (the app refuses to start without them):
SECRET_KEY=
TEAM_EMAIL=
# Production:
# ALLOWED_HOSTS=your-domain.com
# CSRF_TRUSTED_ORIGINS=https://your-domain.com
# DATABASE_URL=postgres://...
# ADMIN_URL=some-hard-to-guess-path/
# EMAIL_HOST=  EMAIL_PORT=587  EMAIL_HOST_USER=  EMAIL_HOST_PASSWORD=  DEFAULT_FROM_EMAIL=
# HSTS_SECONDS=3600   (raise to 31536000 once HTTPS is confirmed)
